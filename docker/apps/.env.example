# Copy this to .env and fill in what you need, then `docker compose up -d`.
#   cp .env.example .env
# .env is gitignored, so your real secrets never end up on GitHub. Most values are
# optional (blank just turns that bit off); the few you actually need to boot are
# flagged below. Handy for generating secrets:  openssl rand -hex 32

# --- Basics (fill these first) ---
TZ=America/New_York
PUID=1000
PGID=1000

# Where persistent data lives on the apps VM (a dir on the `dagger` pool). Each service
# gets its own subdir; create + chown them before the first run (grafana -> 472, loki -> 10001).
APPDATA=/docker/appdata

# --- Domain, DNS & TLS (Caddy) ---
# Your domain. Everything is served at <service>.${APPS_DOMAIN}. Point *.${APPS_DOMAIN}
# at this VM in Pi-hole (split-horizon) so it stays LAN/tailnet-only.
APPS_DOMAIN=home.example.com
# Where Let's Encrypt sends cert-expiry nags.
ACME_EMAIL=you@example.com
# Cloudflare API token for DNS-01 certs (SECRET). Scope it to Zone > DNS > Edit on this zone.
CF_API_TOKEN=
# Caddy also reverse-proxies the media box + Proxmox nodes so they get a real cert instead of
# a bare IP:port. MEDIA_HOST is the media VM's LAN/tailnet IP (the arr/jellyfin/qBit blocks add
# their own :PORT onto it); the Proxmox side reuses PVE1_URL/PVE2_URL from the SSO block below.
MEDIA_HOST=192.168.1.20

# --- Single sign-on (Authentik is the identity provider) ---
# Authentik's own secrets. Generate strong random values:
#   openssl rand -base64 60  (secret key)      openssl rand -base64 36  (db password)
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_PASS=
# First-boot admin (akadmin). Change the password after you log in the first time; the token
# is an initial API token (also used in the runbook's verification step).
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
#
# Client id/secret pairs, one per app that logs in through Authentik. Each pair has to match on
# both sides (Authentik reads it from the blueprint, the app uses it to connect). Just make up a
# random id + secret for each, e.g. `openssl rand -hex 32`.
# Grafana:
GF_OAUTH_CLIENT_ID=
GF_OAUTH_CLIENT_SECRET=
# Gitea (the matching auth source is added once via the gitea CLI):
GITEA_OAUTH_CLIENT_ID=
GITEA_OAUTH_CLIENT_SECRET=
# Proxmox (the matching realm is added once per cluster via the Proxmox CLI):
PVE_OAUTH_CLIENT_ID=
PVE_OAUTH_CLIENT_SECRET=
# Each PVE node's web UI origin, exactly how you browse it (keep :8006, no trailing slash).
# Used as the OIDC redirect URIs, and reused by Caddy's Proxmox proxy blocks above.
PVE1_URL=https://192.168.1.10:8006
PVE2_URL=https://192.168.1.11:8006

# --- Service admin logins (SECRET, set real values in .env) ---
# Grafana initial admin password.
GF_ADMIN_PASSWORD=
# CouchDB backs Obsidian LiveSync.
COUCHDB_USER=admin
COUCHDB_PASSWORD=
# Obsidian webtop (browser Obsidian desktop, a second LiveSync client). This is the KasmVNC login.
OBSIDIAN_APP_USER=admin
OBSIDIAN_APP_PASSWORD=
# Vaultwarden admin panel token. A plain string is simplest. For an Argon2 hash:
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# ⚠️ If you use the hash, double every '$' to '$$' here, or docker-compose eats it and the
#    token silently comes out blank.
VAULTWARDEN_ADMIN_TOKEN=
# (ntfy and Gitea need nothing new here; they derive from APPS_DOMAIN / PUID / PGID.)

# --- Proxmox metrics exporter (optional) ---
# Read-only API token for prometheus-pve-exporter. Make it in Proxmox:
#   Datacenter > Permissions > API Tokens.  PVE_USER looks like "monitoring@pve".
# The host to scrape is set in prometheus.yml.
PVE_USER=
PVE_TOKEN_NAME=
PVE_TOKEN_VALUE=

# --- Homepage dashboard (all optional; blank = that tile just shows "down") ---
# The committed homepage/*.yaml is host-agnostic; these fill in the host-specific bits.
# Apps-stack tiles already work off APPS_DOMAIN, so nothing's needed for those.
#
# Off-stack tile URLs (non-secret). Point at each box's LAN/tailnet address, include the
# scheme, e.g. https://10.0.0.10:8006.
HOMEPAGE_VAR_PVE1_URL=
HOMEPAGE_VAR_PVE2_URL=
HOMEPAGE_VAR_PIHOLE1_URL=
HOMEPAGE_VAR_PIHOLE2_URL=
HOMEPAGE_VAR_JELLYFIN_URL=
# Media VM (medsev) IP only; the arr/qBittorrent tiles build their own :PORT from it.
HOMEPAGE_VAR_MEDIA_HOST=
#
# Optional live-stat widgets. Blank keeps them off (also comment them out in
# homepage/services.yaml until the matching value is set).
# Proxmox: reuse the read-only token. USERNAME is "user@realm!tokenid"
# (e.g. monitoring@pve!prometheus); SECRET is the token value (same as PVE_TOKEN_VALUE).
HOMEPAGE_VAR_PROXMOX_USERNAME=
HOMEPAGE_VAR_PROXMOX_SECRET=
# Grafana read-only stats widget: reuse GF_ADMIN_PASSWORD.
HOMEPAGE_VAR_GRAFANA_PASSWORD=
# Gitea: a personal access token (scope: read:repository, read:misc).
HOMEPAGE_VAR_GITEA_TOKEN=
# Jellyfin: an API key (Dashboard > API Keys).
HOMEPAGE_VAR_JELLYFIN_KEY=
