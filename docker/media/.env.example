# Copy this file to .env and fill in the values. .env is gitignored, never commit it.
#   cp .env.example .env

# --- Common (applied to most containers) ---
TZ=America/New_York
PUID=1000
PGID=1000

# --- qBittorrent / VPN ---
# Your LAN CIDR, so the VPN container still allows local access (web UI, etc.)
VPN_LAN_NETWORK=192.168.1.0/24

# --- Nebula Sync (Pi-hole replication) ---
# IPs of your two Pi-hole instances.
PIHOLE_PRIMARY_IP=192.168.1.2
PIHOLE_REPLICA_IP=192.168.1.3
# Pi-hole web UI passwords (SECRET, leave blank here, set real values in .env).
NEBULA_PRIMARY_PASS=
NEBULA_REPLICA_PASS=

# --- Mousehole (v0.4.0+ requires auth; UI is LAN-reachable via qBittorrent's :5010) ---
MOUSEHOLE_AUTH_PASSWORD=
# Comma-separated Host-header allowlist (v0.4.0 DNS-rebinding guard). Add the hostname
# or LAN IP you browse the UI at; a hostname stays stable if the IP changes.
MOUSEHOLE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mousehole.home.example.com

# --- Flaresolverr ---
LOG_LEVEL=info
LOG_HTML=false
CAPTCHA_SOLVER=none
